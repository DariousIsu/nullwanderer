# AURA NX-Alpha — Environment Configuration
# Copy to .env and fill in values.
# DO NOT commit .env to version control.
#
# NESTED FIELDS: pydantic-settings uses double-underscore (__) as the
# nested delimiter. e.g. interface_model.gguf_path → AURA_INTERFACE_MODEL__GGUF_PATH

# ── Hardware Phase ─────────────────────────────────────────────────────────────
# 1 = S4-Dev (RX 7900 XT 20GB, Qwen3-VL-8B-Instruct + deepseek-r1:14b via Ollama)
# 2 = Phase 2 (eGPU, Gemma 3 27B QAT + larger vision model)
# 3 = Phase 3 (S5-Dual, MOSS-TTSD, SAE verification)
AURA_HARDWARE_PHASE=1

# ── Server ─────────────────────────────────────────────────────────────────────
AURA_HOST=127.0.0.1
AURA_PORT=8000

# ── Interface Model (llama-cpp-python) — Phase 1: Qwen3-VL-8B-Instruct ─────────
# Download from: https://huggingface.co/Qwen/Qwen3-VL-8B-Instruct-GGUF
# File: Qwen3-VL-8B-Instruct-Q4_K_M.gguf  (~4.5GB VRAM)
# mmproj: mmproj-Qwen3-VL-8B-Instruct-F16.gguf  (~1GB VRAM)
AURA_INTERFACE_MODEL__GGUF_PATH=~/.aura/models/Qwen3VL-8B-Instruct-Q4_K_M.gguf
AURA_INTERFACE_MODEL__MMPROJ_PATH=~/.aura/models/mmproj-Qwen3VL-8B-Instruct-F16.gguf
# AURA_INTERFACE_MODEL__CONTEXT_SIZE=32768
# AURA_INTERFACE_MODEL__GPU_LAYERS=-1    # -1 = all layers on GPU (ROCm/HIP)
# AURA_INTERFACE_MODEL__THREADS=8
# AURA_INTERFACE_MODEL__FLASH_ATTN=true

# ── Workhorse Model (Ollama) — Phase 1: deepseek-r1:14b ──────────────────────
# Run: ollama pull deepseek-r1:14b
AURA_WORKHORSE__MODEL=deepseek-r1:14b
# AURA_WORKHORSE__OLLAMA_HOST=http://127.0.0.1:11434
# AURA_WORKHORSE__CONTEXT_SIZE=16384
# AURA_WORKHORSE__NUM_GPU=-1             # -1 = full GPU offload
# Auto-purge: unload workhorse from VRAM after idle timeout
# "5m" = 5 min (default), "10m", "0" = immediate, "-1" = never unload
# AURA_WORKHORSE__KEEP_ALIVE=5m

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required for downloading gated models (e.g. Qwen3-VL-8B-Instruct-GGUF)
# Get token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# ── Document Import ───────────────────────────────────────────────────────────
# Max file size for POST /canvas/document (PDF/DOCX import)
# AURA_MAX_UPLOAD_MB=50

# ── Memory Layer ──────────────────────────────────────────────────────────────
# AURA_MEMORY__SQLITE_DB_PATH=~/.aura/memory.db
# AURA_MEMORY__SLIDING_WINDOW_SIZE=10
# AURA_MEMORY__SLIDING_WINDOW_MAX_TURNS=40
# AURA_MEMORY__CHROMA_PERSIST_DIR=~/.aura/chroma
# AURA_MEMORY__EMBEDDING_MODEL=intfloat/e5-small-v2
# AURA_MEMORY__EMBEDDING_DEVICE=cpu
# AURA_MEMORY__FALKORDB_HOST=localhost
AURA_MEMORY__FALKORDB_PORT=6380   # docker-compose uses 6380 (6379 reserved by eigent-redis)
# AURA_MEMORY__FALKORDB_GRAPH=aura_knowledge

# ── Storage Paths ─────────────────────────────────────────────────────────────
# AURA_STORAGE__LAYER2_PATH=~/.aura/chroma
# AURA_STORAGE__LAYER3_DATA_PATH=~/.aura/falkordb
# AURA_STORAGE__TRAINING_DATA_PATH=~/.aura/training
# AURA_STORAGE__STUDY_DATA_PATH=~/.aura/study
# AURA_STORAGE__VOICE_MODELS_PATH=~/.aura/models/voice
# AURA_STORAGE__API_CACHE_PATH=~/.aura/cache/api_cache.db
# AURA_STORAGE__KNOWLEDGE_DATA_PATH=D:/aura_knowledge   # External drive recommended

# ── Storage Quotas (GB) ────────────────────────────────────────────────────────
# AURA_STORAGE__LAYER2_QUOTA_GB=5.0
# AURA_STORAGE__LAYER3_QUOTA_GB=2.0
# AURA_STORAGE__TRAINING_DATA_QUOTA_GB=2.0
# AURA_STORAGE__STUDY_DATA_QUOTA_GB=10.0
# AURA_STORAGE__VOICE_MODELS_QUOTA_GB=20.0
# AURA_STORAGE__API_CACHE_QUOTA_GB=50.0

# ── Knowledge Layer API Keys (free registrations) ─────────────────────────────
# AURA_KNOWLEDGE__COURTLISTENER_TOKEN=    # courtlistener.com/register/
# AURA_KNOWLEDGE__CONGRESS_API_KEY=       # api.congress.gov
# AURA_KNOWLEDGE__GOVINFO_API_KEY=        # api.govinfo.gov (optional)
# AURA_KNOWLEDGE__OPENSTATES_API_KEY=     # openstates.org/accounts/signup/
# AURA_KNOWLEDGE__CASELAW_API_KEY=        # case.law

# ── Market & Economic Data API Keys ──────────────────────────────────────────
# Defaults are pre-wired. Override here or via the AURA Settings menu.
# AURA_MARKET__FRED_API_KEY=65eb511053bc1dcd7587f9afbc790e82
# AURA_MARKET__BLS_API_KEY=6c109afb471745868913fe37e7cdb788
# AURA_MARKET__BEA_API_KEY=414970EF-0A62-43BF-9D86-332C8B4E5409
# AURA_MARKET__CENSUS_API_KEY=6504e35a8d8f02e65223370ccdcd65720cc8ba39
# AURA_MARKET__NEWS_API_KEY=62c395901c2e4d3887ebde49bedc131c
# AURA_MARKET__POLYGON_API_KEY=PrkD1Pu3twSrQ57mzQwDNwNV2ReAPOAP
# AURA_MARKET__ALPHA_VANTAGE_API_KEY=H44C1U6ORX21JRA1
# AURA_MARKET__OPENWEATHERMAP_API_KEY=   # Optional — Open-Meteo used by default

# ── Team Gate ─────────────────────────────────────────────────────────────────
AURA_TEAM_GATE__DEFAULT_ENABLED=false

# ── Development ───────────────────────────────────────────────────────────────
AURA_DEV_STUB_RESPONSES=false  # Set true only for UI development without models
AURA_LOG_LEVEL=INFO
