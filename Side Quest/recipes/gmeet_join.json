{
  "site": "meet.google.com",
  "task": "join",
  "verified": false,
  "_note": "Pre-join: gmeet code first Escapes/closes the 'Do you want people to hear you' device-permission modal (it covers Join now + the toggles). Then turn OFF mic + camera (OPTIONAL — if the modal was closed without granting devices the toggles may already be off/absent, so skipping them is fine), then Join now. waitFor + Join now are required.",
  "fingerprint": { "url_pattern": "meet.google.com" },
  "steps": [
    { "action": "navigate", "url": "{{url}}", "expectLogin": true },
    { "action": "waitFor",
      "locator": { "method": "getByRole", "role": "button", "name": "Join now" },
      "fallbacks": [ { "method": "getByRole", "role": "button", "name": "Ask to join" }, { "text": "Join now" } ] },
    { "action": "click", "optional": true,
      "locator": { "method": "getByRole", "role": "button", "name": "Turn off microphone" },
      "fallbacks": [ { "css": "div[aria-label='Turn off microphone']" }, { "css": "[data-is-muted=false][aria-label*='microphone' i]" } ] },
    { "action": "click", "optional": true,
      "locator": { "method": "getByRole", "role": "button", "name": "Turn off camera" },
      "fallbacks": [ { "css": "div[aria-label='Turn off camera']" } ] },
    { "action": "click",
      "locator": { "method": "getByRole", "role": "button", "name": "Join now" },
      "fallbacks": [ { "method": "getByRole", "role": "button", "name": "Ask to join" }, { "text": "Join now" }, { "text": "Ask to join" } ],
      "mayNavigate": true }
  ]
}
