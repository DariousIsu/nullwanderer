# Dependencies
node_modules/
# Python sidecar virtualenvs (forecasting + maigret enrichment) — large, machine-built, never commit
sidecar/.venv/
sidecar/maigret_venv/
sidecar/tts_venv/
sidecar/tts_kokoro_venv/
sidecar/stt_onnx_venv/
sidecar/spk_venv/
sidecar/**/reports/

# Credentials — email password, Discord bot token, API keys. NEVER commit.
# Pattern is .env* (not literal .env) so backups like .env.bak_* are also ignored.
.env
.env*

# Runtime / personal state — Zoe's live memory, her file workspace, archives
data/

# Logs / scratch
*.log
*.tmp
boot_cycle.lock

# OS
.DS_Store
Thumbs.db
sidecar/face_venv/

# Boot capture artifacts (Start-Process -RedirectStandardError leaves these at the app root)
boot_*.err
.last_boot_log
# Claude Code worktrees (session-local)
.claude/worktrees/

# Python bytecode (the tissues + vendored cores compile on run)
__pycache__/
*.pyc

sidecar/train_venv/
