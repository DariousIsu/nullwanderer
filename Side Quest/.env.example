# =====================================================================
# Zoe Lane — credentials template.
# Copy to `.env` (which is gitignored) and fill in. `.env` is loaded at boot
# by lib/config.js. Blank values disable the corresponding tool gracefully.
# =====================================================================

# --- Model (single source of truth; swap here, no code edit) ---------
ZOE_MODEL=mistral-small3.2:24b

# --- Outbound email (Gmail SMTP via nodemailer) ----------------------
# Gmail needs a 16-char App Password, NOT the account login password:
#   myaccount.google.com -> Security -> 2-Step Verification -> App passwords
ZOE_EMAIL_USER=you@gmail.com
ZOE_EMAIL_PASS=your-16-char-app-password
ZOE_EMAIL_FROM=Zoe Lane <you@gmail.com>
ZOE_EMAIL_DAILY_CAP=20

# --- Discord bridge (discord.js) -------------------------------------
# Bot token:  discord.com/developers -> app -> Bot -> Reset/Copy Token
# Owner ID:   your Discord user id (Developer Mode -> right-click name -> Copy ID).
#             Zoe accepts DMs ONLY from this id; never servers, never others.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=

# --- Cadence governor (evens out her autonomous activity) ------------
# Optional; sane defaults if omitted. Tune the rhythm of her idle loops:
#   ACTIONS_PER_HOUR — weighted hourly budget (thought=1, utterance/tool=2, email/dm=3)
#   MIN_GAP_SEC      — minimum seconds between any two paced actions (anti-burst)
#   QUIET_FILL_SEC   — quiet longer than this -> relax filters to fill the silence
GOVERNOR_ACTIONS_PER_HOUR=50
GOVERNOR_MIN_GAP_SEC=25
GOVERNOR_QUIET_FILL_SEC=240
